OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6
CONFIDENCE_THRESHOLD=0.7
# Neon Postgres — см. docs/setup/neon-setup.md
DATABASE_URL=postgresql+psycopg://<owner>:<password>@ep-<adjective>-<noun>-<hash>.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=10

# JWT — сгенерировать: openssl rand -hex 32
SECRET_KEY=<openssl rand -hex 32>
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Куки (False на dev без HTTPS, True в проде)
COOKIE_SECURE=False

# CORS — конкретный origin фронтенда (не *)
ALLOWED_ORIGINS=["http://localhost:5173"]

# Engine для парсинга PDF в OpenRouter:
#   mistral-ocr  — OCR ($2/1000 страниц), лучше для табличных бланков СФ
#   native       — модель сама обрабатывает PDF как изображения (только для multimodal)
#   pdf-text     — извлечение текста (бесплатно, плохо работает с табличными формами)
PDF_ENGINE=mistral-ocr

# Логи (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# MinIO (запускать: minio.exe server ./minio-data --console-address ":9001")
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=invoices

# Для разработки и прода — пусто (используется https://openrouter.ai/api/v1).
# Для E2E — http://localhost:8002 (mock-сервер).
# OPENROUTER_BASE_URL=
