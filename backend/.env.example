OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.6
CONFIDENCE_THRESHOLD=0.7
DATABASE_URL=sqlite:///./database.db

# Engine для парсинга PDF в OpenRouter:
#   mistral-ocr  — OCR ($2/1000 страниц), лучше для табличных бланков СФ
#   native       — модель сама обрабатывает PDF как изображения (только для multimodal)
#   pdf-text     — извлечение текста (бесплатно, плохо работает с табличными формами)
PDF_ENGINE=mistral-ocr

# Логи (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# MinIO (запускать: minio.exe server ./minio-data --console-address ":9001")
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=invoices
